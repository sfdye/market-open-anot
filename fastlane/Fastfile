ASC_API_KEY_PATH = "fastlane/asc-api-key.json"

default_platform(:ios)

# ─── iOS: App Store Connect metadata ─────────────────────────────────────
# EAS owns builds and binary submission. This lane only pushes listing text.
# Run after editing fastlane/metadata/{en-US,zh-Hans}/.
#
# To pull existing metadata: fastlane deliver download_metadata
platform :ios do
  desc "Push metadata to App Store Connect (no binary)"
  lane :metadata do
    deliver(
      api_key_path: ASC_API_KEY_PATH,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      metadata_path: "fastlane/metadata",
      submit_for_review: false,
    )
  end
end

# ─── Android: Google Play metadata ───────────────────────────────────────
# EAS owns builds and binary submission. This lane only pushes listing text.
# Run after editing fastlane/metadata/android/{en-US,zh-CN}/.
#
# To pull existing metadata: fastlane supply init
platform :android do
  desc "Push metadata to Google Play (no binary)"
  lane :metadata do
    supply(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_screenshots: true,
      track: "internal",
      metadata_path: "fastlane/metadata/android",
    )
  end
end
