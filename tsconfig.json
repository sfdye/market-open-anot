{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // lib/core/ imports itself with explicit .ts specifiers so `node --test` can strip types
    // and run those files directly; Metro and tsc both resolve them as-is.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Expo's Metro resolver reads these too, so `@/lib/x` works at runtime as well as here.
    // Worth it because the route groups nest three deep.
    "paths": { "@/*": ["./*"] },
    // Pinned rather than left to the automatic node_modules/@types sweep, which would pull in
    // @types/node and retype setTimeout, console and friends as Node's rather than RN's.
    "types": ["expo/types", "geojson"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts"],
  // The tests are a separate program with Node's globals — see tsconfig.test.json.
  "exclude": ["node_modules", "lib/core/**/*.test.ts"]
}
