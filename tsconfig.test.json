{
  // lib/core/ is the pure closure and reminder logic, run directly by `node --test`. It gets
  // its own program with Node's globals and *without* React Native's, so an accidental import
  // of anything from lib/ or a react-native API fails here rather than at runtime on device.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    // Not "nodenext": an Expo package.json cannot be `"type": "module"`, which would make tsc
    // read these as CommonJS and reject the ESM syntax Node happily strips and runs.
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    // Node's type stripping only erases syntax; it cannot compile enums, namespaces or
    // parameter properties, and it needs type-only imports marked as such.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["lib/core/**/*.ts"]
}
